# Copiar a .env y ajustar según el entorno.
# Driver async de PostgreSQL (asyncpg). Formato:
#   postgresql+asyncpg://<usuario>:<password>@<host>:<puerto>/<bd>
# Los caracteres especiales de la contraseña están codificados para URL.
DATABASE_URL=postgresql+asyncpg://proyecto:Bac%22!k%26E%25n%22%23%24d@localhost:5432/coworking

# Imprimir las consultas SQL por consola (debug)
ECHO_SQL=false
